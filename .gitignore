node_modules/

# Every .env flavour holds live session cookies — none of them may be committed.
.env
.env.*
!.env.example

# Captured session data — contains cookies and tokens, never commit.
# The archived form carries the same personal data (name, DOB, document
# number, phone, SMS PIN), so it must be ignored too.
captured/
captured*.zip
node_modules*.zip
screenshots/
user-data/
*.log

# Captured sessions for the rotation — one live cookie jar per entry, i.e.
# several logins in one file. Never commit.
sessions.json
sessions*.json

# Runtime state of a running monitor
.monitor-status.json
monitor.log
