# ============================================================================
#  Termin-soft configuration — copy to .env and fill in.
#  cp .env.example .env
#
#  Never commit .env — it holds your live session cookies.
# ============================================================================

# ----------------------------------------------------------------------------
#  VARIANT 1 — API pinger (monitor.js)
#  Fill these from capture-session.js, or by hand from Chrome DevTools.
# ----------------------------------------------------------------------------

# The XHR endpoint that returns the free dates (NOT the page URL you see in the
# address bar). Example: https://portal.minv.sk/wps/PA_.../getFreeTerms
TARGET_URL=

# GET or POST — whatever DevTools shows for that request.
METHOD=GET

# The whole Cookie header, one line, e.g. "JSESSIONID=abc; PHPSESSID=def"
COOKIE_HEADER=

# Anti-CSRF token, if the request carries one.
CSRF_HEADER_NAME=X-CSRF-TOKEN
CSRF_TOKEN=

# For POST: the exact request payload (JSON string or form-encoded body).
# If the payload contains both ' and " it cannot be quoted safely here — put it
# in a file and point REQUEST_BODY_FILE at it instead.
REQUEST_BODY=
# REQUEST_BODY_FILE=captured/request-body.txt
CONTENT_TYPE=application/json

# Must match the browser you captured the session in, or the server may drop it.
USER_AGENT=
# The wizard page URL — some endpoints reject a missing/foreign Referer.
REFERER=
ORIGIN=

# Any other headers the request needs, as a JSON object.
# EXTRA_HEADERS={"X-Portal-Step":"4"}

# Polling cadence. 15s is a reasonable balance; going below ~10s is asking to
# be rate-limited, and the extra speed buys you nothing.
INTERVAL_MS=15000
JITTER_MS=3000
REQUEST_TIMEOUT_MS=20000

# Stop after this many 401/403/redirect responses. 1 = quit on the first one.
AUTH_FAIL_TOLERANCE=1
NETWORK_FAIL_TOLERANCE=5

# ----------------------------------------------------------------------------
#  VARIANT 2 — browser automation (browser-monitor.js)
# ----------------------------------------------------------------------------

START_URL=https://portal.minv.sk/

# Reuse a profile between runs so cookies survive a restart.
# USER_DATA_DIR=./user-data

# Only if Playwright cannot find Chromium on its own.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium

BROWSER_INTERVAL_MS=20000
# How long to wait after poking the page before reading the result.
CHECK_SETTLE_MS=2500

# How to make the page re-query the server WITHOUT reloading:
#   none     — just re-read the DOM (the page polls by itself)
#   click    — click TRIGGER_SELECTOR (a "Skontrolovať" / refresh button)
#   reselect — flip TRIGGER_SELECTOR (a <select>) to another value and back
#   eval     — run TRIGGER_JS in the page
TRIGGER_MODE=none
# TRIGGER_SELECTOR=select#pracovisko
# TRIGGER_ALT_VALUE=
# TRIGGER_JS=window.refreshTerms && window.refreshTerms()

# Substring of the AJAX URL to snoop on. When it matches, its JSON is used as
# the source of truth instead of the rendered text — far more reliable.
# API_URL_PATTERN=/getFreeTerms

# Limit the text check to one container instead of the whole body.
# SCOPE_SELECTOR=#stepContent
# CSS that only matches a bookable date/time. Presence of any = slot found.
# SLOT_SELECTOR=.calendar-day.available:not(.disabled)

# Only applies when the monitor gives up on errors. When a slot IS found the
# browser always stays open — you still have to click Book in it.
CLOSE_BROWSER_ON_EXIT=false
SCREENSHOT_DIR=screenshots

# ----------------------------------------------------------------------------
#  Detection — shared by both variants
# ----------------------------------------------------------------------------

# Comma-separated. Matching is case- and diacritics-insensitive, so
# "nie su momentalne" matches the real sentence too.
NO_SLOTS_TEXT=Nie sú momentálne dostupné žiadne termíny,Nie sú dostupné žiadne termíny,žiadne voľné termíny

# Optional positive markers, if you know what a hit looks like.
# SLOT_TEXT=Vyberte si termín,Voľné termíny

# Explicit path to the dates array inside the JSON response.
# Leave empty to let the detector find the first array by itself.
# SLOT_JSON_PATH=data.terms

# If the response matches nothing known, treat it as a hit and alarm anyway.
# Noisy, but better than sleeping through a slot. Turn on once you have seen
# what a normal "no slots" response looks like.
TREAT_INCONCLUSIVE_AS_SLOT=false

# ----------------------------------------------------------------------------
#  Alerting
# ----------------------------------------------------------------------------

BEEP_ENABLED=true
BEEP_INTERVAL_MS=700
BEEP_COUNT=3

# Optional phone push — the terminal beep is useless if the PC is in Slovakia
# and you are not. Create a bot with @BotFather, then message it and read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Print a status line every N polls (dots in between).
HEARTBEAT_EVERY=20
