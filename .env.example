# ============================================================================
#  Termin-soft configuration — copy to .env and fill in.
#  cp .env.example .env
#
#  Never commit .env — it holds your live session cookies.
# ============================================================================

# ----------------------------------------------------------------------------
#  VARIANT 1 — API pinger (monitor.js)
#  Fill these from capture-session.js, or by hand from Chrome DevTools.
# ----------------------------------------------------------------------------

# The XHR endpoint that returns the free dates (NOT the page URL you see in the
# address bar). Example: https://portal.minv.sk/wps/PA_.../getFreeTerms
TARGET_URL=

# GET or POST — whatever DevTools shows for that request.
METHOD=GET

# The whole Cookie header, one line, e.g. "JSESSIONID=abc; PHPSESSID=def"
COOKIE_HEADER=

# Anti-CSRF token, if the request carries one.
CSRF_HEADER_NAME=X-CSRF-TOKEN
CSRF_TOKEN=

# For POST: the exact request payload (JSON string or form-encoded body).
# If the payload contains both ' and " it cannot be quoted safely here — put it
# in a file and point REQUEST_BODY_FILE at it instead.
REQUEST_BODY=
# REQUEST_BODY_FILE=captured/request-body.txt
CONTENT_TYPE=application/json

# Must match the browser you captured the session in, or the server may drop it.
USER_AGENT=
# The wizard page URL — some endpoints reject a missing/foreign Referer.
REFERER=
ORIGIN=

# Clean, bookmarkable link put into the slot alert (tappable on a phone),
# instead of the giant session-bound portlet URL.
# BOOK_URL=https://portal.minv.sk/wps/portal/domov/ecu/ecu_elektronicke_sluzby/ecu-vysys/

# Any other headers the request needs, as a JSON object.
# EXTRA_HEADERS={"X-Portal-Step":"4"}

# Poll ONLY the services whose group or name contains this text, instead of
# rotating through every service the wizard offers. Case- and diacritics-
# insensitive, so "registracia" matches "Registrácia dočasného útočiska".
#
# Set this whenever one service is the only one you are applying for.
# monitor.js stops watching on the FIRST hit, so a slot on a service you do not
# need ends the watch on the one you do — and the rotation spends your ~4 calls
# per session on services you will never book.
#
# capture-session.js rebuilds the narrowed body file from each fresh capture
# (the serviceBranchIDs are regenerated per session) and carries this key over.
# ONLY_SERVICE=Registrácia

# Hand straight over to the monitor when the capture finishes: copy
# .env.captured to .env and start polling in the same process, keeping the
# browser (and the session) alive. Default true.
#
# The gap between capture and monitor is where sessions die — they expire after
# 15-30 idle minutes, and one sat unpolled for 2h43m before anyone noticed.
# AUTOSTART_MONITOR=true

# Extra CA certificates, if some host serves an incomplete chain.
# certs/ca-disig.pem is loaded automatically and already covers *.minv.sk —
# set this only for a different host. See README, "Чому TLS ламався".
# EXTRA_CA_FILE=

# ----------------------------------------------------------------------------
#  RELEASE WAVES — the single most valuable setting here
# ----------------------------------------------------------------------------
# The portal does not dribble slots out at random: it publishes them in batches
# at a clock time, and people who get appointments talk about catching "the
# first wave". With four calls to spend, knowing that time is worth more than
# every other scheduling knob here put together.
#
# Set the times and the monitor holds ALL its calls for them — no opening ping,
# nothing spread across the day — then bursts across the release:
#
#   WAVE_TIMES=14:45   ->   14:44:50, 14:45:10, 14:45:30, 14:45:50
#
# It starts WAVE_LEAD_MS early so the burst straddles the release instead of
# arriving after it, and warns when the next wave is further off than a session
# survives (~55 min) — that would be a CAPTCHA spent on nothing.
#
# WAVE_EVERY_MIN turns one known wave into the whole grid: the release runs on
# a fixed interval, so 14:45 every 20 minutes means :05, :25 and :45 past every
# hour. One observed wave is enough to derive all of them.
#
# That changes how the budget is spent. A single daily release is worth all
# four calls. A grid is not: at one call per wave, four calls cover 80 minutes
# of waves — longer than a session lives — while four on one wave would watch
# the next three go past with nothing left. So WAVE_BURST defaults to 1
# whenever WAVE_EVERY_MIN is set, and to CALL_BUDGET when it is not.
#
# WAVE_DAYS restricts it to the days the release actually runs.
#
# Takes priority over POLL_ALIGN_* and INTERVAL_MS. Seconds may be given.
# WAVE_TIMES=14:45
# WAVE_EVERY_MIN=20
# WAVE_DAYS=wed
# WAVE_LEAD_MS=10000
# WAVE_BURST=1                  # calls per wave; default 1 on a grid, CALL_BUDGET otherwise
# POLL_BURST_SPACING_MS=20000   # gap between calls when WAVE_BURST > 1

# Polling cadence, used only when no waves are set. THE PORTAL THROTTLES HARD:
# four answers and the fifth call is CALL_LIMIT. 60s is the safe default; do
# not lower it without a reason. On CALL_LIMIT the monitor backs off
# automatically and recovers on the next clean answer.
INTERVAL_MS=60000
JITTER_MS=15000
REQUEST_TIMEOUT_MS=20000

# Stop after this many 401/403/redirect responses. 1 = quit on the first one.
AUTH_FAIL_TOLERANCE=1
NETWORK_FAIL_TOLERANCE=5

# ----------------------------------------------------------------------------
#  VARIANT 2 — browser automation (browser-monitor.js)
# ----------------------------------------------------------------------------

# portal.minv.sk answers 302 -> pes.minv.sk, so point straight at the new one.
START_URL=https://pes.minv.sk/

# Reuse a profile between runs so cookies survive a restart.
# USER_DATA_DIR=./user-data

# Only if Playwright cannot find Chromium on its own.
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium

BROWSER_INTERVAL_MS=20000
# How long to wait after poking the page before reading the result.
CHECK_SETTLE_MS=2500

# How to make the page re-query the server WITHOUT reloading:
#   none     — just re-read the DOM (the page polls by itself)
#   click    — click TRIGGER_SELECTOR (a "Skontrolovať" / refresh button)
#   reselect — flip TRIGGER_SELECTOR (a <select>) to another value and back
#   eval     — run TRIGGER_JS in the page
TRIGGER_MODE=none
# TRIGGER_SELECTOR=select#pracovisko
# TRIGGER_ALT_VALUE=
# TRIGGER_JS=window.refreshTerms && window.refreshTerms()

# Substring of the AJAX URL to snoop on. When it matches, its JSON is used as
# the source of truth instead of the rendered text — far more reliable.
# API_URL_PATTERN=/getFreeTerms

# Limit the text check to one container instead of the whole body.
# SCOPE_SELECTOR=#stepContent
# CSS that only matches a bookable date/time. Presence of any = slot found.
# SLOT_SELECTOR=.calendar-day.available:not(.disabled)

# Only applies when the monitor gives up on errors. When a slot IS found the
# browser always stays open — you still have to click Book in it.
CLOSE_BROWSER_ON_EXIT=false
SCREENSHOT_DIR=screenshots

# ----------------------------------------------------------------------------
#  Detection — shared by both variants
# ----------------------------------------------------------------------------

# Comma-separated. Matching is case- and diacritics-insensitive, so
# "nie su momentalne" matches the real sentence too.
#
# These are the portal's own strings, lifted from its JS bundle
# (PA_ditec-ecu-vysys): noDatesAvailable and noAvailableSlots. Do not reword
# them — they are compared against what the server actually sends back.
NO_SLOTS_TEXT=Nie sú momentálne dostupné žiadne termíny,Vo zvolenom dátume nie je prístupný žiaden voľný termín,Pre zvolené pracovisko nie je k dispozícii žiadna voľná rezervácia,Pre zvolený deň nie je k dispozícii žiadna voľná

# Optional positive markers, if you know what a hit looks like.
# SLOT_TEXT=Vyberte si termín,Voľné termíny

# Explicit path to the dates array inside the JSON response.
# Leave empty to let the detector find the first array by itself.
#
# For the ECU foreigners' flow the endpoint is .../res/id=available-offices-service-date
# and it answers {"services":[...]} — empty means nothing free. So:
SLOT_JSON_PATH=services

# If the response matches nothing known, treat it as a hit and alarm anyway.
# Noisy, but better than sleeping through a slot. Turn on once you have seen
# what a normal "no slots" response looks like.
TREAT_INCONCLUSIVE_AS_SLOT=false

# ----------------------------------------------------------------------------
#  Alerting
# ----------------------------------------------------------------------------

BEEP_ENABLED=true
BEEP_INTERVAL_MS=700
BEEP_COUNT=3

# Stop the audible alarm after this long and keep polling. A slot you did not
# reach in the first quarter hour has been taken by someone else, and one of
# these beeped for seven days straight. The banner and the Telegram push are
# not affected — only the noise stops.
BEEP_MAX_MS=900000

# Optional phone push — the terminal beep is useless if the PC is in Slovakia
# and you are not. Create a bot with @BotFather, then message it and read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Print a status line every N polls (dots in between).
HEARTBEAT_EVERY=20

# ----------------------------------------------------------------------------
#  Identity prefill — typed into step 1 of the wizard
# ----------------------------------------------------------------------------
# Filled in by capture so the only manual steps left are the CAPTCHA and the
# SMS. Fields are found by their visible Slovak label, not by a selector: the
# portlet's ids are generated and change, "Meno" and "Priezvisko" do not.
# Values are typed key by key — the form validates on keystrokes, so a value
# assigned straight into the box can read as empty to the wizard.
PREFILL_IDENTITY=true

# ID_NAME=
# ID_SURNAME=
# ID_BIRTH_DAY=
# ID_BIRTH_MONTH=
# ID_BIRTH_YEAR=
# ID_DOC_NUMBER=
# ID_PHONE=
# ID_EMAIL=

# Only if a label changes and a field stops being found; pin it to a CSS
# selector, e.g. ID_EMAIL_SELECTOR=#emailInput

# ----------------------------------------------------------------------------
#  Call-budget experiments — all OFF by default
# ----------------------------------------------------------------------------
# A session is cut off after roughly six calls to the date endpoint, and
# nothing tried so far has changed that: slower polling, varied payloads,
# unique URLs, waiting out CALL_LIMIT. Two guesses are left, and both are
# measurable rather than clever. Each writes its outcome to EXPERIMENT_LOG, so
# the answer survives the session that produced it.
#
# None of these touches the CAPTCHA, the SMS, your IP or anybody else's data.
# They replay the portal's own steps with the portal's own payloads.

# HYPOTHESIS 1 — DISPROVEN 2026-10-05. Leave it off.
#
# Measured on three sessions: four answers each, then CALL_LIMIT, identical
# with and without the refresh. The replay itself works — the services step
# hands out a genuinely new serviceBranchID, so the server does build a fresh
# context — and the counter ignores it. It belongs to the session, not the
# context. The replay costs no date budget either, so turning it on is simply
# pointless rather than harmful. Kept to make the measurement repeatable.
#
# The original reasoning, for anyone redoing it:
#
# Why it is plausible: the browser calls the date endpoint exactly once per
# pass, and always right after the services step; the serviceBranchIDs are
# regenerated every pass, so the server builds something new there; and a spent
# session answers {} — "context lost" — rather than 401.
#
# With this on, the monitor replays the services step every N date calls and
# re-points its request at the fresh id.
#
# Whether a refresh COSTS a date call is itself unmeasured: the services step is
# a different resource id (id=reservation) from the date endpoint, and CALL_LIMIT
# was only ever seen on the second. If the counters are separate the refresh is
# free; if shared, each one takes a check away from your six. `npm run experiment`
# tells the two apart from the counts, which is why this starts off.
#
# Test it by hand first, for the price of one SMS: open DevTools -> Network on
# the date step, press "Späť" back to the service choice, pick the same service
# again, and watch whether the dates still arrive after the sixth time round.
# SERVICES_REFRESH=true
# SERVICES_REFRESH_EVERY=3
# SERVICES_REFRESH_GAP_MS=2000

# The step itself, recorded by capture/hunt. Pooled sessions carry their own
# copy in sessions.json; this is only for the single-session .env workflow.
# SERVICES_STEP={"url":"...","method":"POST","body":"reservation=..."}

# HYPOTHESIS 3 — tida looks like a tab id, so the counter may be per tab.
# On CALL_LIMIT the session is retried under each of these before being
# buried. Low odds, and a spent session costs nothing to test on. Empty = off.
# TIDA_RETRY_VALUES=1,2

# Where the outcomes go: one JSON object per line, no cookies and no identity.
# Read it with: npm run experiment
EXPERIMENT_LOG=experiment.jsonl

# ----------------------------------------------------------------------------
#  Watchdog — what happens when every session is spent
# ----------------------------------------------------------------------------
# true  (default): open a window, type the identity in, push "CAPTCHA needed"
#                  to Telegram and wait. The monitor stays up, which is the
#                  whole point — it is the only thing that can alert on a slot.
#                  If no browser can be opened it waits for sessions.json to
#                  gain an entry instead, so `npm run capture` elsewhere is
#                  picked up without a restart.
# false          : the old behaviour — exit 1 and say why.
WATCHDOG_ON_EMPTY_POOL=true
# WATCHDOG_POLL_MS=30000

# The code field is found by state, not wording: the identity form must be gone
# before any label is believed. Measured 2026-10-05 — step 1's own sentence
# "bude zaslaný PIN kód" matched a bare "pin" search, so the CAPTCHA was never
# waited for and the watchdog asked for an SMS the portal never sent.
# Pin it by hand if the field is still missed:
# PIN_SELECTOR=#input-pincode

# Read the SMS code out of the Telegram bot chat instead of typing it at the
# machine. The code lands on your phone, the wizard is on the PC, and this is
# what removes the remote desktop from the loop: you reply with the digits in
# the same chat the slot alerts come from.
#
# Only this chat is read, and only messages sent after the monitor starts
# asking — an old code in the history is expired anyway.
# SMS_CODE_VIA_TELEGRAM=true
# SMS_CODE_TIMEOUT_MS=600000

# Ticked for you on the date step, so the window is left one click from a
# booking. Matched against the radio's visible text, diacritics-insensitive.
# OFFICE=Bratislava

# Starred and listed first in the slot alert. NEVER filters — a slot anywhere
# beats no slot, and the alarm must not stay silent because it was in the wrong
# town. Defaults to OFFICE.
# PREFER_OFFICE=Košice

# When you are reachable to tap a CAPTCHA.
#
# One CAPTCHA buys about an hour of watching with four checks in it — that is
# the portal's allowance and nothing changes it. So the scarce resource is not
# requests, it is your attention: the watchdog should ask while you can answer,
# and the hour it buys should be an hour worth watching.
#
# Unset, it asks the moment the pool dies, which has meant half past three.
#
#   "mon-fri 18:00-22:00, sat+sun 09:00-12:00, 07:00-08:00"
#   a day range, days joined with +, or no day at all for every day
#   a window whose end is before its start runs past midnight
#
# The banner prints how many hours a week the schedule can be asked in — at
# ~1h watched per CAPTCHA, that is the ceiling on coverage, so size it honestly.
# CAPTCHA_WINDOWS=mon-fri 07:00-08:30, mon-fri 18:00-22:00, sat+sun 09:00-13:00

# Which request counts as "the dates" — used by capture, hunt and the audit.
# DATE_ENDPOINT_MARKER=available-offices-service-date
